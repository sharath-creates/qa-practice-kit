<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <!-- The thread name identifies which parallel test produced a line. -->
    <Property name="PATTERN">%d{HH:mm:ss.SSS} %-5level [%t] %logger{1.} - %msg%n</Property>
  </Properties>
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${PATTERN}"/>
    </Console>
    <File name="File" fileName="target/logs/execution.log" append="false">
      <PatternLayout pattern="${PATTERN}"/>
    </File>
  </Appenders>
  <Loggers>
    <Logger name="com.qapractice" level="INFO"/>
    <!-- Selenium's own wire logging is deafening at INFO -->
    <Logger name="org.openqa.selenium" level="WARN"/>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>
